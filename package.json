{
  "name": "bancos-pro",
  "version": "1.0.0",
  "type": "module",
  "description": "API e SDK Oficial de Bancos e Instituições Financeiras do Brasil (base oficial BACEN STR + Pix), código COMPE, ISPB, CNPJ, validação de DV de agência/conta, IBAN brasileiro e banco emissor de boletos na borda Cloudflare Anycast (<2ms).",
  "main": "bancos-pro.js",
  "module": "bancos-pro.js",
